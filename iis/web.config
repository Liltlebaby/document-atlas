<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <rule name="Atlas HTTPS only" stopProcessing="true">
          <match url=".*" />
          <conditions><add input="{HTTPS}" pattern="^OFF$" /></conditions>
          <action type="CustomResponse" statusCode="403" statusReason="HTTPS required" statusDescription="Use the Atlas HTTPS URL" />
        </rule>
        <rule name="Document Atlas loopback" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:8765/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
